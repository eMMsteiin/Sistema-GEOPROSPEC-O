generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum StoreType {
  MULTIBRAND
  OWN_BRAND
}

enum ProspectStatus {
  NOT_VISITED
  VISITED
  PARTNER
  DECLINED
  REQUESTED_TO_REPS // solicitada para os representantes visitarem
}

enum EstablishmentKind {
  PHYSICAL_STORE
  INDIVIDUAL_RESELLER
}

/// Segunda dimensão de classificação, independente de StoreType: não responde
/// "pode vender Vitiss" (isso é o tipo/StoreType), responde "que tipo de loja
/// é essa e como abordar comercialmente". Uma loja pode ter vários perfis ao
/// mesmo tempo (ex.: Boutique de Bairro + Rede Regional).
enum StoreProfile {
  BOUTIQUE_BAIRRO // pequena, atendimento pessoal, nota alta, poucas dezenas-centenas de avaliações
  FORNECEDORA_PROFISSIONAL // atende profissional de salão além do consumidor final, 500+ avaliações
  REVENDA_MULTI_CATALOGO // revende 2+ marcas normalmente exclusivas (Natura/Avon/Eudora/Boticário...) por conta própria
  HIBRIDA_SERVICO // salão/estética com prateleira de produtos junto
  POPULAR_DESCONTO // posicionamento de preço baixo, não combina com o ticket médio da Vitiss
  REDE_REGIONAL // 2+ unidades confirmadas da mesma marca/dono
  CRUZAMENTO_RAMO // negócio principal não é cosmético (celular, moda, papelaria...), cosmético é categoria secundária
}

/// Quão confiável é a coordenada gravada. O Nominatim (OpenStreetMap) tem
/// cobertura fraca de número de porta em rua residencial brasileira, então o
/// pino costuma ser aproximado — a UI precisa dizer isso em vez de fingir
/// precisão que não existe.
enum GeocodePrecision {
  EXACT // número de porta bateu
  STREET // rua certa, número aproximado
  POSTAL // centro do CEP
  NEIGHBORHOOD // centro do bairro
  NONE // não geocodificou
}

model Store {
  id                    String            @id @default(cuid())
  cnpj                  String?           @unique // null = cadastrada manualmente sem CNPJ confirmado ainda
  name                  String
  address               String? // logradouro só (ex.: "Rua Quirino Zagonel")
  addressNumber         String? // número de porta; null = sem número (s/n)
  addressComplement     String? // ex.: "SALA 2", "LOJA 3"
  postalCode            String? // CEP, 8 dígitos sem máscara — chave mais confiável de endereço no Brasil
  neighborhood          String?
  city                  String
  state                 String            @default("PR")
  lat                   Float?
  lng                   Float?
  geocodePrecision      GeocodePrecision  @default(NONE)
  distanceKm            Float?
  googleMapsUrl         String? // link direto confirmado (place_id) — quando presente, substitui o link de busca gerado pelo endereço
  storeType             StoreType         @default(MULTIBRAND)
  storeTypeAuto         Boolean           @default(true) // false = corrigido manualmente, import não sobrescreve mais
  establishmentKind     EstablishmentKind @default(PHYSICAL_STORE)
  establishmentKindAuto Boolean           @default(true) // false = corrigido manualmente, import não sobrescreve mais
  profiles              StoreProfile[]    @default([]) // pode ter mais de um ao mesmo tempo
  profilesAuto          Boolean           @default(true) // false = corrigido manualmente, import não sobrescreve mais
  status                ProspectStatus    @default(NOT_VISITED)
  phone                 String?
  notes                 String?
  visitedByRep          String? // nome do representante que visitou a loja
  cnaeActive            Boolean           @default(true) // situação cadastral ativa na Receita
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([city, neighborhood])
  @@index([status])
}

model RegionIncome {
  id           String   @id @default(cuid())
  city         String
  neighborhood String? // null = valor a nível municipal (todas as cidades do MVP)
  avgIncome    Float // R$, rendimento médio mensal na região
  source       String? // ex.: "Censo 2022 IBGE - SIDRA tabela 10295 (municipal)"
  updatedAt    DateTime @updatedAt

  @@unique([city, neighborhood])
}
